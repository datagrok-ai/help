  {
   "id": 11,
   "type": "timeseries",
   "title": "Transaction IDs used (wraparound at 2.1 billion)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
