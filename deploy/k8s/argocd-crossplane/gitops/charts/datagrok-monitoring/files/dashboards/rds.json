      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "aws_rds_replica_lag_maximum",
     "legendFormat": "{{dbinstance_identifier}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Transaction logs on disk",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
